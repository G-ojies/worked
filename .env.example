# RevenueCat public SDK keys. Copy this file to .env and fill them in.
# Both are public keys, designed to ship inside the app.

# Google Play key (starts with goog_). Used by release builds.
EXPO_PUBLIC_RC_ANDROID_KEY=

# Test Store key (starts with test_). Used by development builds only, so that
# purchases can be exercised with no Play Console setup. RevenueCat crashes a
# release build configured with a Test Store key, and the app never passes it
# to one.
EXPO_PUBLIC_RC_TEST_KEY=

# Set to 1 only for a debuggable demo build handed to testers. It lets the
# Test Store key be used outside development. Never set it for a store build.
EXPO_PUBLIC_DEMO_BUILD=
